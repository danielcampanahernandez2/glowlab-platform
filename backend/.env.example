# Glowlab Backend Environment Variables

# Application
PROJECT_NAME="Glowlab API"
VERSION="0.1.0"
API_V1_STR="/api/v1"
ENVIRONMENT="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]

# Database (PostgreSQL)
POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_USER="glowlab_user"
POSTGRES_PASSWORD="glowlab_secure_password"
POSTGRES_DB="glowlab_db"
DATABASE_URL="postgresql+asyncpg://glowlab_user:glowlab_secure_password@localhost:5432/glowlab_db"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_DB=0
REDIS_URL="redis://localhost:6379/0"

# Security & JWT (To be configured in Phase 3)
SECRET_KEY="temporary-glowlab-dev-secret-key-change-in-production-min-32-chars"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Evolution API
EVOLUTION_API_URL="https://evolution-api-production-2fb7.up.railway.app"
EVOLUTION_API_KEY="your-evolution-api-key"
EVOLUTION_INSTANCE_NAME="glowlab-bot"

# AI Provider ("openai" | "deepseek")
AI_PROVIDER="openai"

# OpenAI Settings
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"

# DeepSeek Settings
DEEPSEEK_API_KEY="sk-your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"

